/// State-wise daily Open-Meteo weather (36 states/UTs, 2022-01-01 to 2024-04-28). Includes Ladakh, Lakshadweep, and Andaman & Nicobar Islands.
table fact_weather
	lineageTag: 35000000-0000-4000-8000-000000000001

	/// Weather date (hidden FK; slice via dim_date[Date])
	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-MM-dd
		lineageTag: 35000000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	/// State/UT name (hidden FK; slice via dim_state[State])
	column State
		dataType: string
		isHidden
		lineageTag: 35000000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: State

	/// Daily mean temperature at 2m (deg C)
	column Avg_Temperature
		dataType: double
		formatString: 0.0
		lineageTag: 35000000-0000-4000-8000-000000000004
		summarizeBy: average
		sourceColumn: Avg_Temperature

	/// Daily maximum temperature at 2m (deg C)
	column Max_Temperature
		dataType: double
		formatString: 0.0
		lineageTag: 35000000-0000-4000-8000-000000000005
		summarizeBy: max
		sourceColumn: Max_Temperature

	/// Daily minimum temperature at 2m (deg C)
	column Min_Temperature
		dataType: double
		formatString: 0.0
		lineageTag: 35000000-0000-4000-8000-000000000006
		summarizeBy: min
		sourceColumn: Min_Temperature

	/// Daily total precipitation (mm)
	column Total_Precipitation
		dataType: double
		formatString: 0.0
		lineageTag: 35000000-0000-4000-8000-000000000007
		summarizeBy: sum
		sourceColumn: Total_Precipitation

	/// Daily max wind speed at 10m (km/h)
	column Avg_Wind_Speed
		dataType: double
		formatString: 0.0
		lineageTag: 35000000-0000-4000-8000-000000000008
		summarizeBy: average
		sourceColumn: Avg_Wind_Speed

	/// Technical calendar column (hidden; use dim_date[Year])
	column Year
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 35000000-0000-4000-8000-000000000009
		summarizeBy: none
		sourceColumn: Year

	/// Technical calendar column (hidden; use dim_date[MonthNumber])
	column Month
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 35000000-0000-4000-8000-000000000010
		summarizeBy: none
		sourceColumn: Month

	partition fact_weather = m
		mode: import
		source =
				let
					Folder = if Text.EndsWith(DataFolder, "\") then DataFolder else DataFolder & "\",
					Source = Csv.Document(File.Contents(Folder & "gold_weather.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					RemovedLatLon = Table.RemoveColumns(Promoted, {"Latitude", "Longitude"}, MissingField.Ignore),
					ChangedType = Table.TransformColumnTypes(RemovedLatLon, {
						{"Date", type date},
						{"State", type text},
						{"Avg_Temperature", type number},
						{"Max_Temperature", type number},
						{"Min_Temperature", type number},
						{"Total_Precipitation", type number},
						{"Avg_Wind_Speed", type number},
						{"Year", Int64.Type},
						{"Month", Int64.Type}
					}, "en-US")
				in
					ChangedType

