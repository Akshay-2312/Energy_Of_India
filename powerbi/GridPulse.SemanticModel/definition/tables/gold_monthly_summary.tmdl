/// Pre-aggregated national monthly energy, peak met, and peak unmet summary.
table gold_monthly_summary
	lineageTag: 37000000-0000-4000-8000-000000000001

	/// Technical calendar year (hidden; use dim_date[Year])
	column Year
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 37000000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: Year

	/// Technical calendar month (hidden; use dim_date[MonthNumber])
	column Month
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 37000000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: Month

	/// Monthly total national energy met (MU)
	column Total_Energy_MU
		dataType: double
		formatString: #,##0.0
		lineageTag: 37000000-0000-4000-8000-000000000004
		summarizeBy: sum
		sourceColumn: Total_Energy_MU

	/// Monthly average daily national energy met (MU)
	column Avg_Daily_Energy_MU
		dataType: double
		formatString: #,##0.0
		lineageTag: 37000000-0000-4000-8000-000000000005
		summarizeBy: average
		sourceColumn: Avg_Daily_Energy_MU

	/// Monthly max daily national energy met (MU)
	column Max_Daily_Energy_MU
		dataType: double
		formatString: #,##0.0
		lineageTag: 37000000-0000-4000-8000-000000000006
		summarizeBy: max
		sourceColumn: Max_Daily_Energy_MU

	/// Monthly average daily peak power met (MW)
	column Avg_Peak_Met_MW
		dataType: double
		formatString: #,##0
		lineageTag: 37000000-0000-4000-8000-000000000007
		summarizeBy: average
		sourceColumn: Avg_Peak_Met_MW

	/// Monthly maximum peak power met (MW)
	column Max_Peak_Met_MW
		dataType: double
		formatString: #,##0
		lineageTag: 37000000-0000-4000-8000-000000000008
		summarizeBy: max
		sourceColumn: Max_Peak_Met_MW

	/// Monthly average daily peak unmet demand (MW)
	column Avg_Peak_Unmet_MW
		dataType: double
		formatString: #,##0
		lineageTag: 37000000-0000-4000-8000-000000000009
		summarizeBy: average
		sourceColumn: Avg_Peak_Unmet_MW

	/// Monthly maximum peak unmet demand (MW)
	column Max_Peak_Unmet_MW
		dataType: double
		formatString: #,##0
		lineageTag: 37000000-0000-4000-8000-000000000010
		summarizeBy: max
		sourceColumn: Max_Peak_Unmet_MW

	/// Number of reported days in the month
	column Days_Reported
		dataType: int64
		formatString: #,##0
		lineageTag: 37000000-0000-4000-8000-000000000011
		summarizeBy: sum
		sourceColumn: Days_Reported

	/// Number of days in the month with Unmet_Energy_Total > 0
	column Unmet_Days
		dataType: int64
		formatString: #,##0
		lineageTag: 37000000-0000-4000-8000-000000000012
		summarizeBy: sum
		sourceColumn: Unmet_Days

	/// First day of month (hidden FK; joins dim_date[Date])
	column Month_Start
		dataType: dateTime
		isHidden
		formatString: yyyy-MM-dd
		lineageTag: 37000000-0000-4000-8000-000000000013
		summarizeBy: none
		sourceColumn: Month_Start

		annotation UnderlyingDateTimeDataType = Date

	partition gold_monthly_summary = m
		mode: import
		source =
				let
					Folder = if Text.EndsWith(DataFolder, "\") then DataFolder else DataFolder & "\",
					Source = Csv.Document(File.Contents(Folder & "gold_monthly_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					ChangedType = Table.TransformColumnTypes(Promoted, {
						{"Year", Int64.Type},
						{"Month", Int64.Type},
						{"Total_Energy_MU", type number},
						{"Avg_Daily_Energy_MU", type number},
						{"Max_Daily_Energy_MU", type number},
						{"Avg_Peak_Met_MW", type number},
						{"Max_Peak_Met_MW", type number},
						{"Avg_Peak_Unmet_MW", type number},
						{"Max_Peak_Unmet_MW", type number},
						{"Days_Reported", Int64.Type},
						{"Unmet_Days", Int64.Type},
						{"Month_Start", type date}
					}, "en-US")
				in
					ChangedType

